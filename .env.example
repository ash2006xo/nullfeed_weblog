# Copy this file to .env and fill in real values. .env is gitignored on purpose.

# Postgres connection
DATABASE_URL=postgres://username:password@localhost:5432/nullfeed?sslmode=disable

# Port the Echo server listens on
PORT=8080

# Secret key used to sign JWTs - must be long and random in production
JWT_SECRET=replace-this-with-a-long-random-string

# Cloudinary (for image uploads) - filled in during deployment
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=